{
  "name": "dsh-pins",
  "version": "1.0.0",
  "description": "记忆钉：跨会话共享的便签板。钉一次，之后每个会话的系统提示都带着它；用户有面板，Agent 有 memory_pins 工具。",
  "icon": "icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./store": "./store.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "store.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "test": "node --test test/",
    "check": "node --check index.js && node --check client.js && node --check store.js && node --test test/"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "memory",
    "notes",
    "pins",
    "web-ui"
  ],
  "author": "yanliao66",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanliao66/dsh-pins.git"
  },
  "homepage": "https://github.com/yanliao66/dsh-pins#readme",
  "bugs": {
    "url": "https://github.com/yanliao66/dsh-pins/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
